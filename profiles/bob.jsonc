{
  // Profilo B.O.B. (Bug-Out Bag): scheda personale nello zaino. Il GPS è facoltativo: il firmware lo accende da solo
  // se la scheda lo ha (Tracker) e lo segna assente se non c'è (Stick); senza GPS l'app usa la posizione del telefono.
  "USERPREFS_SMARTLAB_PROFILE": "1",
  "USERPREFS_SMARTLAB_NAME_LONG": "B.O.B.",
  "USERPREFS_SMARTLAB_NAME_SHORT": "BOB",
  "USERPREFS_CONFIG_DEVICE_ROLE": "meshtastic_Config_DeviceConfig_Role_CLIENT",
  "USERPREFS_CONFIG_SMART_POSITION_ENABLED": "true",
  "USERPREFS_CONFIG_POSITION_BROADCAST_INTERVAL": "900"
}
